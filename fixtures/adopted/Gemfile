# frozen_string_literal: true

# An app that has adopted gem dependency contexts (#154, Stage C): its Gemfile, package.json and
# .proscenium/packages/ at its own root, so Bundler.root is the JavaScript project root, as in a
# real app. Tests drive it as a subprocess (test/adopted/helper.rb).
source 'https://rubygems.org'

gem 'proscenium', path: '../..'
gem 'rails', '8.1.3.1'
# Windows has no zoneinfo database for TZInfo to read. Not platform-gated, as in the repo's Gemfile.
gem 'tzinfo-data'

gems = '../../test/package_manager/stage_a/gems'
gem 'stage_a_widget_a', path: "#{gems}/stage_a_widget_a"
# Built into vendor/cache by test/adopted/helper.rb and installed as an archive, as from a
# registry (C03).
gem 'stage_a_widget_b'

# Gems that do not participate (C01): one self-contained, one relying on the app's packages.
gem 'stage_a_app_dependent', path: "#{gems}/stage_a_app_dependent"
gem 'stage_a_assets', path: "#{gems}/stage_a_assets"
