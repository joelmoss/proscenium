<header>
  <h1>
    <%= @exception_wrapper.exception_class_name %>
    <% if params_valid? && @request.parameters['controller'] %>
      in <%= @request.parameters['controller'].camelize %>Controller<% if @request.parameters['action'] %>#<%= @request.parameters['action'] %><% end %>
    <% end %>
  </h1>
</header>

<main role="main" id="container">
  <%= render "rescues/message_and_suggestions", exception: @exception, exception_wrapper: @exception_wrapper %>

  <%# Go marshals esbuild's Message without JSON tags, so the keys are the Go field names. This
      block read lowercase keys and had never rendered. %>
  <% if (location = @exception.error['Location']) %>
    <div class="source">
      <div class="data">
<pre>

    <%= location['File'] %>:<%= location['Line'] %>:<%= location['Column'] %>

<%= location['Line'].to_s.rjust 5 %> │    <%= location['LineText'] %>
      │    <%= (location['Length'].to_i > 1 ? "~" * location['Length'] : "^").rjust(location['Column'].to_i + location['Length'].to_i) %>
<%- if location['Suggestion'].present? %>    + │    <%= location['Suggestion'].rjust(location['Column'].to_i + 1) %>
<% else %> <%- end %>
</pre>
      </div>
    </div>
  <% end %>

  <%= render template: "rescues/_request_and_response" %>
</main>
