From d551d879af57c2a351a8ddc905a998069416e4d1 Mon Sep 17 00:00:00 2001
From: Joel Moss <joel@developwithstyle.com>
Date: Sat, 19 Sep 2026 16:20:39 +0100
Subject: [PATCH] perf: Cache directory listings for plugin resolve calls in a
 one-shot Build

Every call a plugin makes to build.Resolve reads directories through the
context's file system, which contextImpl creates with DoNotCache because a
long-lived Context would otherwise serve stale listings between rebuilds.
Each call also gets a brand-new resolver, so nothing is shared between calls
either. A plugin that resolves many imports therefore re-reads every parent
directory of every import from scratch, while the bundler's own resolver,
which reads through a per-build cache, reads each directory once.

Build() creates a context, runs a single rebuild and disposes it, so a cache
there cannot outlive the build. contextImpl now takes oneShot: Build() passes
true, so its file system caches directory listings, and Context() passes
false and behaves exactly as before.

One consequence: a file that a plugin creates part-way through a build is not
seen by a later Resolve call in the same build if its directory has already been
listed in that build; a directory that has not been listed yet is read fresh. The
bundler's own resolver already behaves this way.

Measured with a plugin that calls Resolve for every extensionless and bare
import, on a real app with 402 front-end files and 289 gems. Alternating runs,
median of three:

  component.jsx (about 140 modules)  144.4 ms -> 63.7 ms  (-56%)
  sheet/component.js                 138.4 ms -> 63.8 ms  (-54%)
  context_menu.jsx                    41.8 ms -> 34.4 ms  (-18%)
  ibiza/store.js                      10.3 ms ->  7.7 ms  (-25%)

Allocations on the largest builds fall from 1.20M to 0.80M, and the output is
byte-identical for every entry point (bytes, sha256 and ETag compared).
pkg/api, internal/fs, internal/resolver and internal/bundler_tests pass.

Two tests in pkg/api/api_resolve_cache_test.go pin both halves. A plugin resolves
`./late.js`, a file with that name is created, and it resolves again: in a one-shot
Build() the second Resolve must still miss, because the listing is cached for that
build, and in a Context() it must find the file, because a Context outlives its
rebuilds and must never serve a stale listing. The first fails on the code before
this change and both pass with it.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019sGAktov7hLGg4fF9pLUxD
---
 pkg/api/api.go                    |  4 +-
 pkg/api/api_impl.go               | 14 +++--
 pkg/api/api_resolve_cache_test.go | 88 +++++++++++++++++++++++++++++++
 3 files changed, 99 insertions(+), 7 deletions(-)
 create mode 100644 pkg/api/api_resolve_cache_test.go

diff --git a/pkg/api/api.go b/pkg/api/api.go
index 6f53125e..148e1e5d 100644
--- a/pkg/api/api.go
+++ b/pkg/api/api.go
@@ -398,7 +398,7 @@ type OutputFile struct {
 func Build(options BuildOptions) BuildResult {
 	start := time.Now()
 
-	ctx, errors := contextImpl(options)
+	ctx, errors := contextImpl(options, true)
 	if ctx == nil {
 		return BuildResult{Errors: errors}
 	}
@@ -555,7 +555,7 @@ func (err *ContextError) Error() string {
 
 // Documentation: https://esbuild.github.io/api/#build
 func Context(buildOptions BuildOptions) (BuildContext, *ContextError) {
-	ctx, errors := contextImpl(buildOptions)
+	ctx, errors := contextImpl(buildOptions, false)
 	if ctx == nil {
 		return nil, &ContextError{Errors: errors}
 	}
diff --git a/pkg/api/api_impl.go b/pkg/api/api_impl.go
index 258df2ba..e2372288 100644
--- a/pkg/api/api_impl.go
+++ b/pkg/api/api_impl.go
@@ -894,7 +894,11 @@ func cloneMangleCache(log logger.Log, mangleCache map[string]interface{}) map[st
 ////////////////////////////////////////////////////////////////////////////////
 // Build API
 
-func contextImpl(buildOpts BuildOptions) (*internalContext, []Message) {
+// "oneShot" is true for Build(), whose context lives for exactly one rebuild. Only then is it safe
+// for the file system that plugin "resolve" calls read through to cache directory listings: the
+// cache is discarded with the context, so nothing can go stale. A long-lived Context() must keep
+// re-reading them.
+func contextImpl(buildOpts BuildOptions, oneShot bool) (*internalContext, []Message) {
 	logOptions := logger.OutputOptions{
 		IncludeSource: true,
 		MessageLimit:  buildOpts.LogLimit,
@@ -910,10 +914,10 @@ func contextImpl(buildOpts BuildOptions) (*internalContext, []Message) {
 	realFS, err := fs.RealFS(fs.RealFSOptions{
 		AbsWorkingDir: absWorkingDir,
 
-		// This is a long-lived file system object so do not cache calls to
-		// ReadDirectory() (they are normally cached for the duration of a build
-		// for performance).
-		DoNotCache: true,
+		// A long-lived file system object must not cache calls to ReadDirectory() (they are
+		// normally cached for the duration of a build for performance). A one-shot build's context
+		// is discarded after a single rebuild, so it can.
+		DoNotCache: !oneShot,
 	})
 	if err != nil {
 		log := logger.NewStderrLog(logOptions)
diff --git a/pkg/api/api_resolve_cache_test.go b/pkg/api/api_resolve_cache_test.go
new file mode 100644
index 00000000..516ba638
--- /dev/null
+++ b/pkg/api/api_resolve_cache_test.go
@@ -0,0 +1,88 @@
+package api_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/evanw/esbuild/pkg/api"
+)
+
+// A plugin's Resolve reads directories through the file system that contextImpl creates. Build()
+// creates that context, runs a single rebuild and disposes it, so its file system may cache
+// directory listings for that build. A Context() outlives its rebuilds, so it must not, or a file
+// created between two rebuilds would go unseen. These tests pin both halves.
+
+// A plugin that resolves the same path twice, with the file it names created in between.
+func resolveAroundNewFilePlugin(t *testing.T, dir string, results *[2]api.ResolveResult) api.Plugin {
+	return api.Plugin{
+		Name: "resolve-around-new-file",
+		Setup: func(build api.PluginBuild) {
+			build.OnStart(func() (api.OnStartResult, error) {
+				opts := api.ResolveOptions{Kind: api.ResolveJSImportStatement, ResolveDir: dir}
+				results[0] = build.Resolve("./late.js", opts)
+
+				if err := os.WriteFile(filepath.Join(dir, "late.js"), []byte("export {}\n"), 0o644); err != nil {
+					t.Error(err)
+				}
+
+				results[1] = build.Resolve("./late.js", opts)
+				return api.OnStartResult{}, nil
+			})
+		},
+	}
+}
+
+func resolveCacheOptions(t *testing.T, results *[2]api.ResolveResult) api.BuildOptions {
+	dir := t.TempDir()
+	entry := filepath.Join(dir, "entry.js")
+	if err := os.WriteFile(entry, []byte("console.log(1)\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	return api.BuildOptions{
+		EntryPoints:   []string{entry},
+		AbsWorkingDir: dir,
+		Write:         false,
+		LogLevel:      api.LogLevelSilent,
+		Plugins:       []api.Plugin{resolveAroundNewFilePlugin(t, dir, results)},
+	}
+}
+
+func TestBuildCachesDirectoryListingsForPluginResolve(t *testing.T) {
+	var results [2]api.ResolveResult
+
+	result := api.Build(resolveCacheOptions(t, &results))
+
+	if len(result.Errors) > 0 {
+		t.Fatalf("the build failed: %v", result.Errors)
+	}
+	if len(results[0].Errors) == 0 {
+		t.Fatal("the first Resolve found a file that does not exist yet")
+	}
+	if len(results[1].Errors) == 0 {
+		t.Fatal("the second Resolve saw a file created after the first, so directory listings are " +
+			"not cached for the length of a one-shot Build")
+	}
+}
+
+func TestContextDoesNotCacheDirectoryListingsForPluginResolve(t *testing.T) {
+	var results [2]api.ResolveResult
+
+	ctx, err := api.Context(resolveCacheOptions(t, &results))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ctx.Dispose()
+
+	if result := ctx.Rebuild(); len(result.Errors) > 0 {
+		t.Fatalf("the rebuild failed: %v", result.Errors)
+	}
+	if len(results[0].Errors) == 0 {
+		t.Fatal("the first Resolve found a file that does not exist yet")
+	}
+	if len(results[1].Errors) > 0 {
+		t.Fatalf("the second Resolve missed a file created after the first, so a long-lived Context "+
+			"served a stale directory listing: %v", results[1].Errors)
+	}
+}
